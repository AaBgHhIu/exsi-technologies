# =============================================================================
# EXSi Technologies — Environment Variables Configuration Template
# =============================================================================
# Copy this file to .env.local:
#   cp .env.example .env.local
#
# NEVER commit your actual .env.local to GitHub!
# =============================================================================

# 1. Site URL (used for sitemaps, OpenGraph cards, redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2. Supabase Configuration (Get these from https://supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
# Server-only. Never prefix this key with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# 3. Website enquiry email delivery (Resend)
# Add these in Vercel and use a sender address verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=hello@exsitechnologies.com
